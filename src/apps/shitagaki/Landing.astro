---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import { site } from '@/config/site';
import { getSupportEmail } from '@/apps';
import { defaultLocale } from '@/config/i18n';
import { localizePath, t } from '@/i18n';
import type { AppPageProps } from '@/apps/types';
import Icon from './components/Icon.astro';
import './theme.css';

/**
 * アイコンは photo-diary の iOS アイコン定義（`design/icon.icon/`）から起こしたものです。
 * マークは `design/icon.icon/Assets/icontest.png.svg`、背景は `icon.json` の
 * automatic-gradient（display-p3 0.99608 0.98824 0.96863）に合わせたクリームのグラデーションで、
 * 1024×1024 に合成しています。`assets/icon.png` は Expo の既定アイコンのままなので使いません。
 */
import icon from '@/assets/shitagaki/icon.png';
import DeviceFrame from './components/DeviceFrame.astro';

/**
 * App Store 提出用のスクリーンショット（photo-diary リポジトリの
 * `design/ios-submission/ja/` から書き出したもの）。
 */
import shotHome from '@/assets/shitagaki/home.png';
import shotEdit1 from '@/assets/shitagaki/edit1.png';
import shotEdit2 from '@/assets/shitagaki/edit2.png';
import shotKousei from '@/assets/shitagaki/kousei.png';
import shotPreview from '@/assets/shitagaki/preview.png';
import shotReorder from '@/assets/shitagaki/reorder.png';

interface Props extends AppPageProps {}

const { app, locale = defaultLocale } = Astro.props;
const supportEmail = getSupportEmail(app);
const year = new Date().getFullYear();

const description =
  '下書きは、旅先や日常の写真を見ながら話すだけで、AI が見出し付きのブログ記事・旅行記の下書きに整える iPhone / iPad アプリです。録音を止めずに写真をスワイプすると、話した内容が見ていた写真に自動で紐づきます。Markdown / HTML / ZIP で書き出せて、アカウント登録は不要。App Store で無料配信中です。';

const faqs = [
  {
    q: '下書きは無料で使えますか？',
    a: '無料で使えます。下書きの作成・録音・メモ・構成の編集・プレビューに制限はありません。AI の構成生成だけが通算 10 回までの無料枠で、書き出しは書き出しプランまたは AI Plus でご利用いただけます。',
  },
  {
    q: '写真や録音はサーバーに送られますか？',
    a: '原本の写真ファイルと録音は送りません。写真・録音・メモは端末内に保存され、設定で有効にすれば同一 Apple ID の端末間で iCloud 同期もできます。AI 構成生成を実行したときだけ、タイトル・メモ本文・撮影日時などのテキストと、各写真の一覧用サムネイル（縮小 JPEG）を Cloudflare 経由で Google Gemini に送ります。',
  },
  {
    q: 'オフラインでも使えますか？',
    a: 'AI 構成生成以外はオフラインで使えます。写真の選択、録音、文字起こし、メモの編集、プレビューまでは通信なしで完結します。',
  },
  {
    q: '書き出した記事はブログにそのまま貼れますか？',
    a: 'Markdown / HTML / ZIP で書き出せます。ZIP には画像も含まれるので、ブログ記事の下書きとしてそのまま持ち込めます。',
  },
  {
    q: '広告は表示されますか？',
    a: '自分で「動画を見る」を選んだときに再生されるリワード動画だけです。バナーや全画面広告が勝手に出ることはありません。無料の AI 構成生成を使い切ったあと、1 回ぶんを得るために任意で視聴できます（AI は 1 日 1 回・1 か月 5 回、書き出しは 1 日 1 回まで）。AI Plus 購読中は表示されません。書き出しの買い切り後も、無料 AI 枠を使い切ると AI 用動画は出ることがあります。広告は常に非パーソナライズで、ATT の許可も求めません。',
  },
  {
    q: '対応している端末と iOS のバージョンは？',
    a: 'iPhone / iPad に対応し、iOS 26 以降が必要です。端末内で文字起こしを行うため、iOS 26 の音声認識を利用しています。',
  },
] as const;

const gallery = [
  { src: shotHome, alt: '下書き一覧画面。撮影日と枚数つきで下書きが並ぶ', caption: '下書き一覧', body: '撮った日付・枚数ごとに整理されます。' },
  { src: shotEdit1, alt: '写真ごとのメモ編集画面。マイク・写真追加・次へのボタンが並ぶ', caption: '写真ごとにメモ', body: '話すか、キーボードで書くか選べます。' },
  { src: shotEdit2, alt: '録音中の画面。写真を切り替えながら話した内容が自動で振り分けられる', caption: '録りながらスワイプ', body: '止めずに話し続けるだけで、写真ごとに整理されます。' },
  { src: shotKousei, alt: '構成の指示を話すか入力する画面。トーンや順番のヒントチップが並ぶ', caption: 'AI が構成を提案', body: '指示は任意。省略しても構成を組み立てます。' },
  { src: shotReorder, alt: '構成カードをドラッグで並べ替える確認画面', caption: '並べ替えて確認', body: '提案された構成はカード単位で組み直せます。' },
  { src: shotPreview, alt: '記事プレビュー画面。記事表示と Markdown 表示を切り替えられる', caption: '記事 / Markdown プレビュー', body: '仕上がりを見比べながら書き出せます。' },
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
});

const steps = [
  {
    title: '写真を選ぶ',
    body: '記事に使う写真を選んで、ドラッグで並べ替えます。その並びがそのまま記事の流れになり、写真はあとから追加も削除もできます。',
  },
  {
    title: '録りながらスワイプ',
    body: '録音を止めずに横へスワイプすると、話した内容が見ていた写真に自動で振り分けられます。声が出しづらい場所では、キーボードでも入力できます。',
  },
  {
    title: 'AI が構成をつくる',
    body: '「旅日記っぽく」といった指示は任意です。省略すれば、AI がふさわしいと判断した構成を組み立てます。',
  },
  {
    title: '並べ替えて書き出す',
    body: '提案された構成カードをドラッグで並べ替え、記事表示と Markdown を見比べて仕上げます。完成した記事は Markdown / HTML / ZIP で書き出せます。',
  },
];

const features = [
  {
    icon: 'mic',
    title: '声でタイトルと構成',
    body: 'タイトルも構成の指示も、話しかけるだけで入力できます。キーボード入力も併用できます。',
  },
  {
    icon: 'swipe',
    title: '録音とスワイプの自動紐づけ',
    body: '一本の連続録音のまま写真を切り替えると、その時に話した内容が写真ごとに整理されます。',
  },
  {
    icon: 'reorder',
    title: '写真の並べ替え',
    body: '選んだ写真をドラッグして並べ替え。並び順がそのまま記事の流れになります。',
  },
  {
    icon: 'sparkles',
    title: 'AI 構成生成',
    body: '話した内容に撮影日時や地名も手がかりとして加え、見出しと本文の構成を提案します。',
  },
  {
    icon: 'cards',
    title: '構成カードの編集',
    body: '提案された構成はカード単位で並べ替え・編集できます。納得いくまで組み直せます。',
  },
  {
    icon: 'images',
    title: '写真とテキストを自由に並べる',
    body: '写真の間にテキストだけのブロックも挿入できます。並び順はフィルムストリップからドラッグで変更できます。',
  },
  {
    icon: 'undo',
    title: '写真ごとにやり直せる',
    body: 'AI が構成を生成したあとも、写真ごとにテキストを個別に元に戻したりやり直したりできます。',
  },
  {
    icon: 'markdown',
    title: '記事 / Markdown プレビュー',
    body: '仕上がりの見た目と Markdown を切り替えながら確認できます。',
  },
  {
    icon: 'share',
    title: 'Markdown / HTML / ZIP 書き出し',
    body: '画像を含めて書き出せるので、そのままブログ記事の下書きとして使えます。',
  },
  {
    icon: 'image-settings',
    title: '画像設定',
    body: '書き出す画像の長辺サイズ・形式（JPEG / PNG）・品質を選べます。端末の元の写真はそのままです。',
  },
  {
    icon: 'text',
    title: 'プレビュー表示設定',
    body: '本文フォント、文字サイズ、行間、見出しの下線などを好みに合わせて調整できます。',
  },
  {
    icon: 'palette',
    title: 'ライト / ダークとアクセント 6 色',
    body: '端末の設定に合わせる、または手動で切り替え。アクセントカラーも 6 色から選べます。',
  },
  {
    icon: 'search',
    title: '検索とアーカイブ',
    body: '下書きはキーワードで検索でき、書き終えたものはアーカイブに移して整理できます。',
  },
  {
    icon: 'offline',
    title: 'アカウント不要・オフライン',
    body: 'サインインは要りません。AI 構成生成のとき以外は、通信がなくても使えます。',
  },
] as const;

const plans = [
  {
    name: '無料',
    featured: false,
    price: '¥0',
    unit: 'アカウント登録なし',
    quota: 'AI 構成生成が通算 10 回',
    points: [
      '下書きの作成・録音・メモ・編集',
      '構成カードの並べ替えとプレビュー',
      '表示設定・テーマの変更',
      '無料枠はリセットされない通算 10 回です',
      '使い切ったあとは、動画を見て 1 回ぶん追加できます',
    ],
  },
  {
    name: '書き出しプラン',
    featured: false,
    price: '¥980',
    unit: '買い切り',
    quota: 'Markdown / HTML / ZIP の書き出し',
    points: [
      '一度のお支払いでずっと書き出せます',
      'サブスクリプションではありません',
      'AI 構成生成の回数は無料枠のまま（通算 10 回）',
      '無料枠を使い切ったあとの AI 用動画は、必要なら引き続き選べます',
    ],
  },
  {
    name: 'AI Plus',
    featured: true,
    price: '¥980',
    unit: '/ 月',
    quota: 'AI 構成生成が毎月 50 回',
    points: [
      '年額 ¥7,800 でもご利用いただけます',
      '購読中は書き出しも回数無制限で使えます',
      '生成し直しも同じ月の枠から使えます',
      'いつでも解約できます',
    ],
  },
];

const comparison = [
  { label: '下書きの作成・録音・メモ', free: '○', exportPlan: '○', ai: '○' },
  { label: '構成カードの編集・プレビュー', free: '○', exportPlan: '○', ai: '○' },
  { label: 'AI 構成生成', free: '通算 10 回', exportPlan: '通算 10 回', ai: '毎月 50 回' },
  { label: 'Markdown / HTML / ZIP 書き出し', free: '—', exportPlan: '○', ai: '○' },
  { label: '画像設定・表示設定・テーマ', free: '○', exportPlan: '○', ai: '○' },
  { label: '検索・アーカイブ', free: '○', exportPlan: '○', ai: '○' },
  // AI の無料枠は書き出しプランでも共通なので、動画の案内が出ないのは AI Plus だけです
  { label: '広告', free: '任意の動画のみ', exportPlan: '任意の動画のみ', ai: 'なし' },
];

const privacyPoints = [
  'アカウント登録もサインインも不要です',
  '写真・録音・メモ・下書きは端末内に保存され、任意で iCloud 同期もできます',
  '原本の写真ファイルを当方のサーバーへ送ることはありません',
  'AI 構成生成時だけ、テキストと一覧用サムネイルを Gemini（失敗時は Groq）へ送ります',
  '地名を送るかどうかは下書きごとにオフにできます（初期オフ・緯度経度は送りません）',
  '位置情報の許可は求めません',
  '広告は、自分で「動画を見る」を選んだときのリワード動画だけです',
  '広告目的のトラッキングは行わず、ATT の許可も求めません',
];
---

<BaseLayout
  title="写真を見ながら話すだけで記事の下書きができる AI 日記アプリ"
  app={app}
  locale={locale}
  description={description}
  ogImage={icon.src}
  schemaCategory="LifestyleApplication"
  isAppHome
>
  <a class="sg-skip" href="#sg-main">本文へスキップ</a>

  <header class="sg-nav">
    <div class="sg-nav__inner">
      <p class="sg-nav__brand">
        <Image src={icon} alt="" width={32} height={32} loading="eager" />
        <span>{app.name}</span>
        <em>Draft</em>
      </p>
      <nav class="sg-nav__links" aria-label="ページ内リンク">
        <a href="#sg-steps" data-optional>使い方</a>
        <a href="#sg-features" data-optional>機能</a>
        <a href="#sg-faq" data-optional>よくある質問</a>
        <a href="#sg-plans">プラン</a>
        <a href={localizePath(`${app.slug}/support/`, locale)}>{t(locale, 'nav.support')}</a>
        {
          app.appStoreUrl && (
            <a class="sg-btn sg-btn--primary sg-btn--sm" href={app.appStoreUrl} rel="noopener">
              <Icon name="apple" />
              <span>
                App Store<span class="sg-nav__cta-suffix"> で入手</span>
              </span>
            </a>
          )
        }
      </nav>
    </div>
  </header>

  <main id="sg-main">
    <section class="sg-band sg-hero">
      <div class="sg-band__inner sg-hero__inner">
        <div class="sg-hero__copy">
          <p class="sg-hero__badges">
            <span class="sg-badge sg-badge--dot">App Store で配信中</span>
          </p>
          <h1 class="sg-h1">写真を見ながら、<br />話すだけ。</h1>
          <p class="sg-lead">
            旅先や日常の写真をスワイプしながら話すと、話した内容を AI
            が見出し付きの記事の下書きに整えます。文章を書くのが得意でなくても、自分の言葉がそのまま記事になります。
          </p>
          <div class="sg-cta">
            {
              app.appStoreUrl && (
                <a class="sg-btn sg-btn--primary" href={app.appStoreUrl} rel="noopener">
                  <Icon name="apple" />
                  App Store で入手（無料）
                </a>
              )
            }
            <a class="sg-btn sg-btn--ghost" href="#sg-steps">
              使い方を見る
              <Icon name="chevron" />
            </a>
          </div>
          <p class="sg-hero__meta">
            iPhone / iPad に対応｜iOS 26 以降が必要です{app.version && `｜v${app.version}`}
          </p>
        </div>

        <div class="sg-hero__art">
          <span class="sg-hero__glow" aria-hidden="true"></span>
          <div class="sg-hero__tile">
            <Image
              src={icon}
              alt="下書きのアプリアイコン"
              widths={[240, 480, 720]}
              sizes="(max-width: 900px) 52vw, 240px"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="sg-band sg-band--surface" aria-labelledby="sg-gallery-title">
      <div class="sg-band__inner">
        <div class="sg-head">
          <p class="sg-eyebrow">アプリの画面</p>
          <h2 id="sg-gallery-title" class="sg-h2">見て、話して、記事になるまで。</h2>
        </div>

        <div class="sg-gallery">
          <ul class="sg-gallery__track">
            {
              gallery.map((shot) => (
                <li class="sg-gallery__item">
                  <DeviceFrame src={shot.src} alt={shot.alt} />
                  <h3>{shot.caption}</h3>
                  <p>{shot.body}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="sg-band sg-band--alt" id="sg-steps" aria-labelledby="sg-steps-title">
      <div class="sg-band__inner">
        <div class="sg-head">
          <p class="sg-eyebrow">使い方</p>
          <h2 id="sg-steps-title" class="sg-h2">書こうとしなくていい。見て、話すだけ。</h2>
          <p class="sg-sub">
            録音を止めずに写真を切り替えるだけで、話した内容が写真ごとに整理されていきます。
          </p>
        </div>

        <ol class="sg-steps">
          {
            steps.map((step) => (
              <li class="sg-step">
                <span class="sg-step__num" aria-hidden="true" />
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="sg-band sg-band--surface" id="sg-features" aria-labelledby="sg-features-title">
      <div class="sg-band__inner">
        <div class="sg-head">
          <p class="sg-eyebrow">機能</p>
          <h2 id="sg-features-title" class="sg-h2">話した言葉が、記事の形になるまで。</h2>
        </div>

        <ul class="sg-features">
          {
            features.map((feature) => (
              <li class="sg-feature">
                <span class="sg-feature__icon">
                  <Icon name={feature.icon} />
                </span>
                <div class="sg-feature__text">
                  <h3>{feature.title}</h3>
                  <p>{feature.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="sg-band sg-band--alt" id="sg-plans" aria-labelledby="sg-plans-title">
      <div class="sg-band__inner">
        <div class="sg-head">
          <p class="sg-eyebrow">プラン</p>
          <h2 id="sg-plans-title" class="sg-h2">まず無料で。書き出したくなったら、必要な分だけ。</h2>
          <p class="sg-sub">
            記事を書くところまでは無料で使えます。書き出しだけが必要なら買い切り、AI
            を何度も使うなら AI Plus です。
          </p>
        </div>

        <ul class="sg-plans">
          {
            plans.map((plan) => (
              <li class="sg-plan" data-featured={plan.featured}>
                <div class="sg-plan__head">
                  <h3>{plan.name}</h3>
                  {plan.featured && <span class="sg-badge">AI をよく使う方に</span>}
                </div>
                <p class="sg-plan__price">
                  <strong>{plan.price}</strong>
                  <span>{plan.unit}</span>
                </p>
                <p class="sg-plan__quota">{plan.quota}</p>
                <ul class="sg-plan__list">
                  {plan.points.map((point) => (
                    <li>
                      <Icon name="check" />
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>

        <div class="sg-table-wrap">
          <table class="sg-table">
            <caption>プランごとにできること</caption>
            <thead>
              <tr>
                <th scope="col">機能</th>
                <th scope="col">無料</th>
                <th scope="col">書き出しプラン</th>
                <th scope="col">AI Plus</th>
              </tr>
            </thead>
            <tbody>
              {
                comparison.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td>
                      <span class="sg-mark" data-on={row.free === '○'}>
                        {row.free}
                      </span>
                      {row.free === '—' && <span class="sg-sr">利用できません</span>}
                    </td>
                    <td>
                      <span class="sg-mark" data-on={row.exportPlan === '○'}>
                        {row.exportPlan}
                      </span>
                      {row.exportPlan === '—' && <span class="sg-sr">利用できません</span>}
                    </td>
                    <td>
                      <span class="sg-mark" data-on={row.ai === '○'}>
                        {row.ai}
                      </span>
                      {row.ai === '—' && <span class="sg-sr">利用できません</span>}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="sg-note sg-note--fine">
          書き出しプランは買い切り（サブスクリプションではありません）。AI Plus
          は自動更新サブスクリプションです。無料トライアルはありません。期間終了の 24
          時間以上前に解約しない限り自動更新されます。購入・更新・解約・復元は App Store
          経由で行われ、解約は「設定 &gt; Apple ID &gt;
          サブスクリプション」から行えます。買い切りの書き出しは一度のご購入で以後もご利用いただけます。AI
          Plus の月あたりの回数は暦月ごとにリセットされます。掲載している価格は日本ストアの予定価格で、実際の価格は
          App Store に表示される金額が正となります。
        </p>
      </div>
    </section>

    <section class="sg-band sg-band--surface" id="sg-faq" aria-labelledby="sg-faq-title">
      <div class="sg-band__inner">
        <div class="sg-head">
          <p class="sg-eyebrow">よくある質問</p>
          <h2 id="sg-faq-title" class="sg-h2">はじめる前に、気になるところ。</h2>
        </div>

        <ul class="sg-faq">
          {
            faqs.map((faq) => (
              <li class="sg-faq__item">
                <h3>{faq.q}</h3>
                <p>{faq.a}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="sg-band sg-band--alt sg-privacy" aria-labelledby="sg-privacy-title">
      <div class="sg-band__inner">
        <div class="sg-privacy__head">
          <span class="sg-privacy__icon">
            <Icon name="lock" />
          </span>
          <h2 id="sg-privacy-title" class="sg-h2">写真も、声も、端末の中に。</h2>
        </div>

        <ul class="sg-checks">
          {
            privacyPoints.map((point) => (
              <li>
                <Icon name="check" />
                <span>{point}</span>
              </li>
            ))
          }
        </ul>

        <p class="sg-note">
          詳しくは<a href={localizePath(`${app.slug}/privacy/`, locale)}
            >{t(locale, 'nav.privacy')}</a
          >をご覧ください。
        </p>
      </div>
    </section>

    <section class="sg-band sg-closing">
      <div class="sg-band__inner">
        <h2 class="sg-h2">{app.tagline}</h2>
        <p class="sg-sub">思い出が薄れないうちに、その日のうちに話しておく。</p>
        <div class="sg-cta sg-cta--center">
          {
            app.appStoreUrl && (
              <a class="sg-btn sg-btn--primary" href={app.appStoreUrl} rel="noopener">
                <Icon name="apple" />
                App Store で入手（無料）
              </a>
            )
          }
        </div>
        <p class="sg-note sg-note--fine">
          構成や本文は AI が生成したものです。公開・共有する前に、内容をご自身でご確認ください。
        </p>
      </div>
    </section>
  </main>

  <footer class="sg-footer">
    <div class="sg-footer__inner">
      <p class="sg-footer__brand">{app.name}</p>
      <nav class="sg-footer__links" aria-label="フッター">
        <a href={localizePath('', locale)}>ホーム</a>
        <a href={localizePath(`${app.slug}/support/`, locale)}>{t(locale, 'nav.support')}</a>
        <a href={localizePath(`${app.slug}/privacy/`, locale)}>{t(locale, 'nav.privacy')}</a>
        <a href={localizePath(`${app.slug}/terms/`, locale)}>{t(locale, 'nav.terms')}</a>
        <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
      </nav>
      <LanguageSwitcher locale={locale} />
      <p class="sg-footer__meta">&copy; {year} {site.operatorName}</p>
    </div>
  </footer>

  <script type="application/ld+json" is:inline set:html={faqJsonLd} />
</BaseLayout>
