---
/** アプリ本体（Ionicons の outline 系）に合わせた 24px ストロークアイコン */
interface Props {
  name:
    | 'mic'
    | 'swipe'
    | 'sparkles'
    | 'cards'
    | 'markdown'
    | 'share'
    | 'images'
    | 'reorder'
    | 'undo'
    | 'image-settings'
    | 'text'
    | 'palette'
    | 'search'
    | 'archive'
    | 'offline'
    | 'device'
    | 'lock'
    | 'check'
    | 'chevron'
    | 'apple';
}

const { name } = Astro.props;

const paths: Record<Props['name'], string> = {
  mic: '<rect x="9" y="2.5" width="6" height="11" rx="3"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0"/><path d="M12 18v3.5"/>',
  swipe:
    '<rect x="6" y="4" width="12" height="16" rx="2.5"/><path d="M3.5 9.5 1.5 12l2 2.5"/><path d="M20.5 9.5 22.5 12l-2 2.5"/>',
  sparkles:
    '<path d="M10 3.5 11.6 8 16 9.6 11.6 11.2 10 15.7 8.4 11.2 4 9.6 8.4 8Z"/><path d="M17.5 14.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8Z"/>',
  cards:
    '<rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/><path d="M6.5 7h5"/><path d="M6.5 17h5"/>',
  markdown:
    '<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M6 15.5v-7l3 3.5 3-3.5v7"/><path d="M16.5 8.5v6"/><path d="m14 12 2.5 2.5L19 12"/>',
  share:
    '<path d="M12 15V3"/><path d="M8 7l4-4 4 4"/><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/>',
  images:
    '<rect x="3" y="5" width="18" height="14" rx="2.5"/><circle cx="8.5" cy="10" r="1.6"/><path d="m4 17 4.5-4.5 3.5 3.5 3-3L20 17"/>',
  reorder: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/><path d="m8 4.5-2 2.5 2 2.5"/><path d="m16 14.5 2 2.5-2 2.5"/>',
  undo: '<path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-2"/>',
  'image-settings':
    '<rect x="3" y="4.5" width="13" height="10" rx="2"/><path d="m4 12 3.5-3.5 3 3"/><circle cx="17.5" cy="17.5" r="3"/><path d="M17.5 12.5v1.4"/><path d="M17.5 21.1v1.4"/><path d="m13.6 15.3 1.2.7"/><path d="m20.2 19.1 1.2.7"/>',
  text: '<path d="M5 6.5V5h14v1.5"/><path d="M12 5v14"/><path d="M9 19h6"/>',
  palette:
    '<path d="M12 3a9 9 0 1 0 0 18 2 2 0 0 0 1.6-3.2 2 2 0 0 1 1.6-3.2H18a3 3 0 0 0 3-3.1A9 9 0 0 0 12 3Z"/><circle cx="8" cy="10" r="1.1"/><circle cx="12" cy="7.5" r="1.1"/><circle cx="15.8" cy="10" r="1.1"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="M16.5 16.5 21 21"/>',
  archive:
    '<rect x="3" y="4" width="18" height="4.5" rx="1.5"/><path d="M5 8.5V19a1.5 1.5 0 0 0 1.5 1.5h11A1.5 1.5 0 0 0 19 19V8.5"/><path d="M10 12h4"/>',
  offline:
    '<path d="M5 12.5a4 4 0 0 1 3.4-4 5.5 5.5 0 0 1 10.4 1.6A3.5 3.5 0 0 1 18.5 17H8a3.5 3.5 0 0 1-3-4.5Z"/><path d="m9.5 20.5 5-3"/>',
  device: '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M10.5 5.5h3"/>',
  lock: '<rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  check: '<path d="m4 12.5 5 5 11-11"/>',
  chevron: '<path d="m9 5 7 7-7 7"/>',
  apple:
    '<path d="M16.5 1.6c0 1.2-.45 2.3-1.34 3.2-.9.9-1.98 1.44-3.14 1.35a3.4 3.4 0 0 1 1.2-3.2A4.9 4.9 0 0 1 16.5 1.6Zm3.9 15.9c-.5 1.16-.86 1.9-1.5 2.93-.9 1.44-2.16 3.23-3.73 3.24-1.4.01-1.75-.92-3.65-.9-1.9.01-2.29.92-3.68.9-1.57-.01-2.77-1.62-3.66-3.06-2.5-4.03-2.77-8.76-1.22-11.27a5.6 5.6 0 0 1 4.6-2.8c1.66 0 2.7.93 4.08.93 1.33 0 2.14-.93 4.06-.93 1.45 0 3 .8 4.09 2.2-3.6 2.02-3.01 7.3.61 8.76Z"/>',
};

/** Apple ロゴだけは塗りで描く（ストロークだと潰れる） */
const filled = new Set<Props['name']>(['apple']);
const isFilled = filled.has(name);
---

<svg
  class="sg-icon"
  viewBox="0 0 24 24"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
