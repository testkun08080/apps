---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import iphoneFrame from '@/assets/devices/iphone-frame.png';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** ヒーロー用の 1 枚だけ eager に読ませます */
  eager?: boolean;
  widths?: number[];
  sizes?: string;
}

const { src, alt, caption, eager = false, widths, sizes } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
const imgWidths = widths ?? [300, 460, 620];
const imgSizes = sizes ?? '(max-width: 640px) 68vw, 300px';
---

<figure class="sg-shot">
  <!-- App Store 用と同じ iPhone モックアップを枠に使う。dynamic island はスクショ側に写っている -->
  <div class="sg-device">
    <Image
      class="sg-device__frame"
      src={iphoneFrame}
      alt=""
      widths={imgWidths}
      sizes={imgSizes}
      loading={loading}
    />
    <div class="sg-device__screen">
      <Image
        src={src}
        alt={alt}
        widths={imgWidths}
        sizes={imgSizes}
        loading={loading}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
