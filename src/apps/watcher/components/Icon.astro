---
/** アプリ本体の線アイコンに合わせた 24px ストロークアイコン */
interface Props {
  name:
    | 'eye'
    | 'sparkle'
    | 'schedule'
    | 'bolt'
    | 'report'
    | 'bell'
    | 'inbox'
    | 'search'
    | 'tag'
    | 'sync'
    | 'export'
    | 'mail'
    | 'theme'
    | 'globe'
    | 'layers'
    | 'lock'
    | 'check'
    | 'chevron'
    | 'apple';
}

const { name } = Astro.props;

const paths: Record<Props['name'], string> = {
  eye: '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="3.25"/>',
  sparkle:
    '<path d="M12 3.5 13.7 8.3 18.5 10l-4.8 1.7L12 16.5l-1.7-4.8L5.5 10l4.8-1.7Z"/><path d="M18.5 15.5l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7Z"/>',
  schedule:
    '<rect x="3" y="5" width="18" height="16" rx="2.5"/><path d="M3 10h18"/><path d="M8 3v4"/><path d="M16 3v4"/><path d="M12 13.5v2.5l1.75 1"/>',
  bolt: '<path d="M13 2.5 5 13.5h6l-2 8 8-11h-6Z"/>',
  report:
    '<path d="M5 4h11l3 3v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"/><path d="M8 11h8"/><path d="M8 15h5"/>',
  bell: '<path d="M18 9a6 6 0 1 0-12 0c0 5-2 6-2 6h16s-2-1-2-6Z"/><path d="M10.5 20a2 2 0 0 0 3 0"/>',
  inbox:
    '<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M3 14h4l1.5 2.5h7L17 14h4"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="M16.5 16.5 21 21"/>',
  tag: '<path d="M11.5 3H20a1 1 0 0 1 1 1v8.5a1 1 0 0 1-.3.7l-7.5 7.5a1 1 0 0 1-1.4 0l-8-8a1 1 0 0 1 0-1.4l7.5-7.5a1 1 0 0 1 .7-.3Z"/><circle cx="16.5" cy="7.5" r="1.4"/>',
  sync: '<path d="M20 12a8 8 0 0 1-13.7 5.6L4 15.5"/><path d="M4 12a8 8 0 0 1 13.7-5.6L20 8.5"/><path d="M20 4v4.5h-4.5"/><path d="M4 20v-4.5h4.5"/>',
  export:
    '<path d="M12 15V3"/><path d="M8 7l4-4 4 4"/><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 5.5L20 7"/>',
  theme:
    '<circle cx="12" cy="12" r="4.5"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="M4.2 4.2l1.4 1.4"/><path d="M18.4 18.4l1.4 1.4"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="M4.2 19.8l1.4-1.4"/><path d="M18.4 5.6l1.4-1.4"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18"/><path d="M12 3a14 14 0 0 0 0 18"/>',
  layers: '<path d="M12 3 3 7.5 12 12l9-4.5Z"/><path d="m3 12.5 9 4.5 9-4.5"/>',
  lock: '<rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  check: '<path d="m4 12.5 5 5 11-11"/>',
  chevron: '<path d="m9 5 7 7-7 7"/>',
  apple:
    '<path d="M16.5 1.6c0 1.2-.45 2.3-1.34 3.2-.9.9-1.98 1.44-3.14 1.35a3.4 3.4 0 0 1 1.2-3.2A4.9 4.9 0 0 1 16.5 1.6Zm3.9 15.9c-.5 1.16-.86 1.9-1.5 2.93-.9 1.44-2.16 3.23-3.73 3.24-1.4.01-1.75-.92-3.65-.9-1.9.01-2.29.92-3.68.9-1.57-.01-2.77-1.62-3.66-3.06-2.5-4.03-2.77-8.76-1.22-11.27a5.6 5.6 0 0 1 4.6-2.8c1.66 0 2.7.93 4.08.93 1.33 0 2.14-.93 4.06-.93 1.45 0 3 .8 4.09 2.2-3.6 2.02-3.01 7.3.61 8.76Z"/>',
};

const filled = new Set<Props['name']>(['apple']);
const isFilled = filled.has(name);
---

<svg
  class="wt-icon"
  viewBox="0 0 24 24"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
