---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import iphoneFrame from '@/assets/devices/iphone-frame.png';
import ipadFrame from '@/assets/devices/ipad-frame.svg';
import watchFrame from '@/assets/devices/watch-frame.svg';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** ヒーロー用の 1 枚だけ eager に読ませます */
  eager?: boolean;
  widths?: number[];
  sizes?: string;
  /**
   * 端末の種類。iPhone は App Store 用と同じモックアップ画像、iPad / Watch は同じ色味の SVG を枠に使う
   * (dynamic island などはスクショ側に写っているので枠では描かない)。
   */
  variant?: 'phone' | 'tablet' | 'watch';
}

const { src, alt, caption, eager = false, widths, sizes, variant = 'phone' } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
const imgWidths = widths ?? [300, 460, 620];
const imgSizes = sizes ?? '(max-width: 640px) 68vw, 300px';
const vectorFrame = variant === 'tablet' ? ipadFrame : variant === 'watch' ? watchFrame : undefined;
---

<figure class="lo-shot">
  <div class:list={['lo-device', `lo-device--${variant}`]}>
    {
      variant === 'phone' && (
        <Image
          class="lo-device__frame"
          src={iphoneFrame}
          alt=""
          widths={imgWidths}
          sizes={imgSizes}
          loading={loading}
        />
      )
    }
    {
      vectorFrame && (
        <img
          class="lo-device__frame"
          src={vectorFrame.src}
          width={vectorFrame.width}
          height={vectorFrame.height}
          alt=""
          loading={loading}
          decoding="async"
        />
      )
    }
    <div class="lo-device__screen">
      <Image
        src={src}
        alt={alt}
        widths={imgWidths}
        sizes={imgSizes}
        loading={loading}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
