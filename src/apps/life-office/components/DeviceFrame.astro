---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** ヒーロー用の 1 枚だけ eager に読ませます */
  eager?: boolean;
  widths?: number[];
  sizes?: string;
  /** 端末の種類。iPhone は dynamic island 付き、iPad / Watch は画面比率とフレームが変わる */
  variant?: 'phone' | 'tablet' | 'watch';
}

const { src, alt, caption, eager = false, widths, sizes, variant = 'phone' } = Astro.props;
---

<figure class="lo-shot">
  <div class:list={['lo-device', variant !== 'phone' && `lo-device--${variant}`]}>
    <div class="lo-device__screen">
      <Image
        src={src}
        alt={alt}
        widths={widths ?? [300, 460, 620]}
        sizes={sizes ?? '(max-width: 640px) 68vw, 300px'}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    </div>
    {variant === 'phone' && <span class="lo-device__island" aria-hidden="true"></span>}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
