---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import iphoneFrame from '@/assets/devices/iphone-frame.png';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** ヒーロー用の 1 枚だけ eager に読ませます */
  eager?: boolean;
  widths?: number[];
  sizes?: string;
  /**
   * 端末の種類。iPhone は App Store 用と同じモックアップ画像を枠に使う
   * (スクショ側に dynamic island が写っているので枠では描かない)。iPad / Watch は CSS の枠。
   */
  variant?: 'phone' | 'tablet' | 'watch';
}

const { src, alt, caption, eager = false, widths, sizes, variant = 'phone' } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
const imgWidths = widths ?? [300, 460, 620];
const imgSizes = sizes ?? '(max-width: 640px) 68vw, 300px';
---

<figure class="lo-shot">
  <div class:list={['lo-device', `lo-device--${variant}`]}>
    {
      variant === 'phone' && (
        <Image
          class="lo-device__frame"
          src={iphoneFrame}
          alt=""
          widths={imgWidths}
          sizes={imgSizes}
          loading={loading}
        />
      )
    }
    <div class="lo-device__screen">
      <Image
        src={src}
        alt={alt}
        widths={imgWidths}
        sizes={imgSizes}
        loading={loading}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
