---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import { site } from '@/config/site';
import { getSupportEmail } from '@/apps';
import { defaultLocale } from '@/config/i18n';
import { localizePath, t } from '@/i18n';
import type { AppPageProps } from '@/apps/types';
import DeviceFrame from './components/DeviceFrame.astro';
import Icon from './components/Icon.astro';
import './theme.css';

import icon from '@/assets/life-office/icon.png';
import shotHome from '@/assets/life-office/home.png';
import shotPunch from '@/assets/life-office/punch.png';
import shotReceipt from '@/assets/life-office/receipt.png';
import shotList from '@/assets/life-office/list.png';
import shotCalendar from '@/assets/life-office/calendar.png';
import shotStats from '@/assets/life-office/stats-monthly.png';
import shotHeatmap from '@/assets/life-office/stats-heatmap.png';
import shotWidget from '@/assets/life-office/widget.png';

interface Props extends AppPageProps {}

const { app, locale = defaultLocale } = Astro.props;
const supportEmail = getSupportEmail(app);
const year = new Date().getFullYear();

const gallery = [
  {
    src: shotPunch,
    caption: 'スワイプ打刻',
    body: 'ワンスワイプで出勤・退勤をかんたんに記録。',
    alt: '出勤ボタンをスワイプして打刻する画面。中央に大きな打刻スイッチが表示されている',
  },
  {
    src: shotReceipt,
    caption: '打刻レシート',
    body: 'その日の記録をレシート風に。写真で保存・共有も。',
    alt: '打刻直後に表示されるレシート画面。氏名・日付・時刻・メモとバーコードが印字されている',
  },
  {
    src: shotList,
    caption: '記録一覧',
    body: '過去の記録を一覧で確認。コメントも残せます。',
    alt: '月ごとの打刻記録を並べた一覧画面。出勤時刻と退勤時刻が日付ごとに並んでいる',
  },
  {
    src: shotCalendar,
    caption: 'カレンダー',
    body: 'ひと月分をカレンダー表示。日付をタップで詳細へ。',
    alt: '出勤した日にマークが付いた月間カレンダー画面',
  },
  {
    src: shotStats,
    caption: '月次統計',
    body: '出勤日数や平均時間などをグラフで可視化。',
    alt: '平均出勤時間・平均退勤時間・合計勤務時間と日別勤務時間の棒グラフを表示した統計画面',
  },
];

const features = [
  { icon: 'swipe', title: 'スワイプ打刻', body: '出勤・退勤を儀式として記録します。' },
  { icon: 'shake', title: '振り打刻', body: '端末を振って打刻。設定で ON / OFF できます。' },
  { icon: 'clock', title: '後打刻', body: '打ち忘れた記録をあとから追加できます。' },
  {
    icon: 'note',
    title: '出勤前メモ / 退勤コメント',
    body: 'その日の一言を打刻に添えて残せます。',
  },
  {
    icon: 'receipt',
    title: '打刻レシート',
    body: '記録をレシート風に表示し、写真に保存・共有できます。',
  },
  {
    icon: 'calendar',
    title: '記録・カレンダー',
    body: '月間の出勤を一覧とカレンダーで確認できます。',
  },
  { icon: 'chart', title: '月次統計', body: 'その月の出勤を集計して表示します。' },
  { icon: 'bell', title: 'リマインダー', body: '指定時刻に打刻をお知らせします。' },
  {
    icon: 'sync',
    title: 'iCloud 同期',
    body: '同じ Apple ID の端末間で、打刻と設定を自動で同期します。',
  },
  {
    icon: 'theme',
    title: 'ライトテーマ',
    body: '無料ではライト固定。ダークとシステム追従は Pro で選べます。',
  },
  {
    icon: 'note',
    title: '日本語 / 英語',
    body: '端末の言語に追従します。設定からいつでも切り替えられます。',
  },
] as const;

const proFeatures = [
  {
    icon: 'noAds',
    title: '広告の非表示',
    body: 'アプリ内のバナー広告がすべて消えます。購入直後から、画面を切り替えずに反映。',
  },
  {
    icon: 'widget',
    title: 'ホーム画面ウィジェット',
    body: '今日の打刻状況と今月の合計勤務時間を、ホーム画面から一目で。',
  },
  {
    icon: 'theme',
    title: 'ダークテーマ',
    body: 'ダークとシステム追従を手動で選べます。ライトは無料のまま使えます。',
  },
  {
    icon: 'chart',
    title: '拡張統計',
    body: '曜日ごとの週次集計と、出勤時刻のヒートマップ。',
  },
  {
    icon: 'search',
    title: 'メモ検索',
    body: '全文検索・日付・退勤コメントの有無で記録を絞り込み。',
  },
  {
    icon: 'export',
    title: 'CSV / PDF',
    body: '月・年・期間指定で書き出し（複数月は ZIP）。CSV からの取り込みにも対応。',
  },
] as const;

const comparison = [
  { label: '広告の非表示', free: false },
  { label: 'スワイプ打刻・振り打刻・後打刻', free: true },
  { label: '出勤前メモ / 退勤コメント', free: true },
  { label: 'レシート表示・写真保存・共有', free: true },
  { label: '記録一覧・カレンダー・月次統計', free: true },
  { label: '目標時刻・勤務曜日・毎日のリマインダー', free: true },
  { label: 'iCloud 同期', free: true },
  { label: 'ライトテーマ', free: true },
  { label: 'ダークテーマ／システム追従', free: false },
  { label: 'ホーム画面ウィジェット', free: false },
  { label: '拡張統計（週次・ヒートマップ）', free: false },
  { label: 'メモ検索', free: false },
  { label: 'CSV / PDF エクスポート、CSV インポート', free: false },
  { label: 'レシートのバーコードの内容', free: false },
];

const privacyPoints = [
  'アカウント登録は不要です',
  '打刻記録は端末内の SQLite にだけ保存されます',
  '打刻データが当方のサーバーへ送信されることはありません',
  'オフラインでも使えます',
  '広告は非パーソナライズのみ。トラッキング許可（ATT）は求めません',
];
---

<BaseLayout
  title="出勤・退勤をスワイプ記録する打刻アプリ"
  app={app}
  locale={locale}
  description="LIFE OFFICE は、出勤・退勤をスワイプ一つで記録する個人用の打刻・タイムカードアプリです。GPSや会社連携は不要、記録は端末内だけに保存されます。怠惰な自分に、毎朝ひとつの儀式を。iPhone / iPad 対応、無料でダウンロードできます。"
  ogImage={icon.src}
  schemaCategory="ProductivityApplication"
  isAppHome
>
  <a class="lo-skip" href="#lo-main">本文へスキップ</a>

  <header class="lo-nav">
    <div class="lo-nav__inner">
      <p class="lo-nav__brand">
        <Image src={icon} alt="" width={32} height={32} loading="eager" />
        <span>{app.name}</span>
      </p>
      {
        app.appStoreUrl && (
          <a class="lo-btn lo-btn--primary lo-btn--sm" href={app.appStoreUrl} rel="noopener">
            <Icon name="apple" />
            <span>App Store<span class="lo-nav__cta-suffix"> で入手</span></span>
          </a>
        )
      }
    </div>
  </header>

  <main id="lo-main">
    <section class="lo-band lo-hero">
      <div class="lo-band__inner lo-hero__inner">
        <div class="lo-hero__copy">
          <h1 class="lo-h1">怠惰な自分に、<br />毎朝ひとつの<br />儀式を。</h1>
          <p class="lo-lead">
            LIFE OFFICE は、昔のタイムカードの「カチッ」をスマホで再現する出勤アプリです。
            GPS も会社との連携も不要。あなただけの出勤スイッチとして使えます。
          </p>
          <div class="lo-cta">
            {
              app.appStoreUrl && (
                <a class="lo-btn lo-btn--primary" href={app.appStoreUrl} rel="noopener">
                  <Icon name="apple" />
                  App Store で入手
                </a>
              )
            }
            <a class="lo-btn lo-btn--link" href={localizePath(`${app.slug}/support/`, locale)}>
              サポート
              <Icon name="chevron" />
            </a>
          </div>
          <p class="lo-hero__meta">
            iPhone / iPad に対応｜iOS 16.0 以降が必要です{app.version && `｜v${app.version}`}
          </p>
        </div>

        <div class="lo-hero__art">
          <span class="lo-hero__blob" aria-hidden="true"></span>
          <div class="lo-hero__devices">
            <div class="lo-hero__device lo-hero__device--main">
              <DeviceFrame
                src={shotHome}
                alt="勤務中のホーム画面。出勤時刻 08:40、経過時間 06:29 と退勤ボタンが表示されている"
                eager={true}
                widths={[340, 520, 680]}
                sizes="(max-width: 900px) 60vw, 320px"
              />
            </div>
            <div class="lo-hero__device lo-hero__device--sub">
              <DeviceFrame
                src={shotPunch}
                alt="出勤ボタンをスワイプして打刻する画面"
                widths={[220, 340, 440]}
                sizes="(max-width: 900px) 34vw, 180px"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="lo-band lo-band--surface" aria-labelledby="lo-gallery-title">
      <div class="lo-band__inner">
        <div class="lo-head">
          <h2 id="lo-gallery-title" class="lo-h2">打刻から記録まで、ひとつのアプリで。</h2>
          <p class="lo-sub">打刻する、レシートを残す、あとから振り返る。</p>
        </div>

        <div class="lo-gallery">
          <ul class="lo-gallery__track">
            {
              gallery.map((shot) => (
                <li class="lo-gallery__item">
                  <DeviceFrame src={shot.src} alt={shot.alt} />
                  <h3>{shot.caption}</h3>
                  <p>{shot.body}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <p class="lo-gallery__note">iPhone / iPad に対応</p>
      </div>
    </section>

    <section class="lo-band lo-band--alt" aria-labelledby="lo-features-title">
      <div class="lo-band__inner">
        <div class="lo-head">
          <p class="lo-eyebrow">無料でできること</p>
          <h2 id="lo-features-title" class="lo-h2">便利な機能で、毎日をもっと快適に。</h2>
          <p class="lo-sub">
            無料プランでは、記録・検索・設定とレシート画面にバナー広告が表示されます。
            出勤タブと打刻の儀式には広告を出しません。Pro を購入すると広告は表示されなくなります。
          </p>
        </div>

        <ul class="lo-features">
          {
            features.map((feature) => (
              <li class="lo-feature">
                <span class="lo-feature__icon">
                  <Icon name={feature.icon} />
                </span>
                <div class="lo-feature__text">
                  <h3>{feature.title}</h3>
                  <p>{feature.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="lo-band lo-band--surface lo-pro" aria-labelledby="lo-pro-title">
      <div class="lo-band__inner">
        <div class="lo-head">
          <p class="lo-eyebrow">{app.name} Pro</p>
          <h2 id="lo-pro-title" class="lo-h2">記録を、もっと使えるものに。</h2>
          <p class="lo-price">
            <strong>¥600</strong>
            <span class="lo-price__tag">買い切り</span>
          </p>
          <p class="lo-sub">サブスクリプションではありません。より高度な機能で働き方をサポート。</p>
        </div>

        <div class="lo-pro__body">
          <ul class="lo-features lo-features--pro">
            {
              proFeatures.map((feature) => (
                <li class="lo-feature">
                  <span class="lo-feature__icon">
                    <Icon name={feature.icon} />
                  </span>
                  <div class="lo-feature__text">
                    <h3>{feature.title}</h3>
                    <p>{feature.body}</p>
                  </div>
                </li>
              ))
            }
          </ul>

          <div class="lo-pro__shots">
            <DeviceFrame
              src={shotWidget}
              alt="ホーム画面に置いた LIFE OFFICE のウィジェット。出勤時刻・経過時間・予定退勤と今月の合計勤務時間のグラフが表示されている"
              caption="ウィジェット"
            />
            <DeviceFrame
              src={shotHeatmap}
              alt="出勤時刻の傾向を色の濃さで示したヒートマップ画面"
              caption="ヒートマップ"
            />
          </div>
        </div>

        <div class="lo-table-wrap">
          <table class="lo-table">
            <caption>無料 / Pro でできること</caption>
            <thead>
              <tr>
                <th scope="col">機能</th>
                <th scope="col">無料</th>
                <th scope="col">Pro</th>
              </tr>
            </thead>
            <tbody>
              {
                comparison.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td>
                      <span class="lo-mark" data-on={row.free}>
                        {row.free ? '○' : '—'}
                      </span>
                      <span class="lo-sr">{row.free ? '利用できます' : '利用できません'}</span>
                    </td>
                    <td>
                      <span class="lo-mark" data-on="true">○</span>
                      <span class="lo-sr">利用できます</span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="lo-band lo-band--alt lo-privacy" aria-labelledby="lo-privacy-title">
      <div class="lo-band__inner">
        <div class="lo-privacy__head">
          <span class="lo-privacy__icon">
            <Icon name="lock" />
          </span>
          <h2 id="lo-privacy-title" class="lo-h2">データは、あなたの端末の中だけに。</h2>
        </div>

        <ul class="lo-checks">
          {
            privacyPoints.map((point) => (
              <li>
                <Icon name="check" />
                <span>{point}</span>
              </li>
            ))
          }
        </ul>

        <p class="lo-note">
          詳しくは<a href={localizePath(`${app.slug}/privacy/`, locale)}>{t(locale, 'nav.privacy')}</a>をご覧ください。
        </p>
      </div>
    </section>

    <section class="lo-band lo-closing">
      <div class="lo-band__inner">
        <h2 class="lo-h2">{app.tagline}</h2>
        <div class="lo-cta lo-cta--center">
          {
            app.appStoreUrl && (
              <a class="lo-btn lo-btn--primary" href={app.appStoreUrl} rel="noopener">
                <Icon name="apple" />
                App Store で入手
              </a>
            )
          }
        </div>
        <p class="lo-note lo-note--fine">
          シンプルで、続けやすい。本アプリは雇用主向けの勤怠管理サービスではなく、
          個人の習慣づくりを目的としています。
        </p>
      </div>
    </section>
  </main>

  <footer class="lo-footer">
    <div class="lo-footer__inner">
      <p class="lo-footer__brand">{app.name}</p>
      <nav class="lo-footer__links" aria-label="フッター">
        <a href={localizePath('', locale)}>ホーム</a>
        <a href={localizePath(`${app.slug}/updates/`, locale)}>{t(locale, 'nav.updates')}</a>
        <a href={localizePath(`${app.slug}/support/`, locale)}>{t(locale, 'nav.support')}</a>
        <a href={localizePath(`${app.slug}/privacy/`, locale)}>{t(locale, 'nav.privacy')}</a>
        <a href={localizePath(`${app.slug}/terms/`, locale)}>{t(locale, 'nav.terms')}</a>
        <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
      </nav>
      <LanguageSwitcher locale={locale} />
      <p class="lo-footer__meta">&copy; {year} {site.operatorName}</p>
    </div>
  </footer>
</BaseLayout>
