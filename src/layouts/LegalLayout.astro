---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import '@/styles/legal.css';
import { site } from '@/config/site';
import type { AppConfig, ResolvedAppConfig } from '@/apps/types';
import { getSupportEmail } from '@/apps';
import { defaultLocale, type Locale } from '@/config/i18n';
import { formatDate, localizePath, t } from '@/i18n';

interface Props {
  title: string;
  app?: ResolvedAppConfig;
  rawApp?: AppConfig;
  currentPath?: 'support' | 'privacy' | 'terms';
  updated?: Date;
  locale?: Locale;
}

const { title, app, rawApp, currentPath, updated, locale = defaultLocale } = Astro.props;
const appForLinks = rawApp ?? app;
const supportEmail = appForLinks ? getSupportEmail(appForLinks) : site.defaultSupportEmail;

const navItems = appForLinks
  ? ([
      {
        key: 'support',
        label: t(locale, 'nav.support'),
        href: localizePath(`${appForLinks.slug}/support/`, locale),
      },
      {
        key: 'privacy',
        label: t(locale, 'nav.privacy'),
        href: localizePath(`${appForLinks.slug}/privacy/`, locale),
      },
      {
        key: 'terms',
        label: t(locale, 'nav.terms'),
        href: localizePath(`${appForLinks.slug}/terms/`, locale),
      },
    ] as const)
  : [];
---

<BaseLayout title={title} app={appForLinks} locale={locale}>
  {
    appForLinks && (
      <header class="site-header">
        <div class="site-header__inner">
          <p class="site-header__title">
            <a href={localizePath(`${appForLinks.slug}/`, locale)}>{app?.name ?? appForLinks.name}</a>
          </p>
        </div>
      </header>
    )
  }

  <main class="legal-main">
    <h1 class="page-title">{title}</h1>

    {
      updated && (
        <p class="page-meta">
          {t(locale, 'meta.lastUpdated')}: {formatDate(updated, locale)}
          {site.operatorName.trim() && <> · {t(locale, 'meta.operator')}: {site.operatorName}</>}
        </p>
      )
    }

    {
      navItems.length > 0 && (
        <nav class="nav-links" aria-label={t(locale, 'aria.legalNav')}>
          {navItems.map((item) => (
            <a href={item.href} aria-current={currentPath === item.key ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      )
    }

    <div class="prose">
      <slot />
    </div>

    {
      app && currentPath !== 'support' && (
        <div class="contact-block">
          <p>
            {t(locale, 'meta.contact')}: <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
          </p>
        </div>
      )
    }
  </main>

  <footer class="site-footer">
    <LanguageSwitcher locale={locale} />
    <p>
      &copy; {new Date().getFullYear()} {site.operatorName}
      {appForLinks && (
        <>
          {' '}
          · <a href={localizePath('', locale)}>{t(locale, 'footer.appList')}</a>
        </>
      )}
    </p>
  </footer>
</BaseLayout>
