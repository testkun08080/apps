---
import '@/styles/reset.css';
import type { AppConfig } from '@/apps/types';
import { themeToCss } from '@/lib/theme';
import { site } from '@/config/site';
import { defaultLocale, type Locale } from '@/config/i18n';
import { getAlternateUrls, resolveLocalized } from '@/i18n';
import { buildGaConfigScript, cspHash, parsePageAnalytics } from '@/lib/analytics';
import { jsonForInlineScript } from '@/lib/json';
import GoogleAnalytics from '@/components/GoogleAnalytics.astro';

interface Props {
  title: string;
  app?: AppConfig;
  locale?: Locale;
  description?: string;
  /** OGP 画像の URL（省略時はアプリアイコン／サイト既定） */
  ogImage?: string;
  /** schema.org SoftwareApplication の applicationCategory（省略時は ProductivityApplication） */
  schemaCategory?: string;
  /** true のとき、かつ app.appStoreUrl があるとき、SoftwareApplication の構造化データを出力する */
  isAppHome?: boolean;
}

const { title, app, locale = defaultLocale, description, ogImage, schemaCategory, isAppHome } = Astro.props;
const appName = app ? resolveLocalized(app.name, locale) : undefined;
const pageTitle = app && title !== appName ? `${title} — ${appName}` : title;
const pageDescription =
  description ?? (appName ? `${appName} — ${title}` : title);
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, site.publicBaseUrl).href;
const ogImageUrl = ogImage ? new URL(ogImage, site.publicBaseUrl).href : undefined;
const themeCss = app ? themeToCss(app.slug, app.theme, app.darkTheme) : undefined;
const alternateUrls = getAlternateUrls(Astro.url.pathname, locale);
const pageAnalytics = parsePageAnalytics(Astro.url.pathname, app?.slug);
const gaId = site.googleAnalyticsId;
const enableGa = import.meta.env.PROD && gaId.length > 0;

// GitHub Pages ではレスポンスヘッダを設定できないため、<meta> で CSP を付与する。
// （frame-ancestors / report-uri / sandbox は meta では無効）
const gaHosts = ['https://www.googletagmanager.com', 'https://*.google-analytics.com', 'https://*.analytics.google.com'];
const scriptSrc = ["'self'", ...(enableGa ? [cspHash(buildGaConfigScript(gaId, pageAnalytics)), gaHosts[0]] : [])];
const csp = [
  "default-src 'self'",
  `script-src ${scriptSrc.join(' ')}`,
  // Astro のスコープ CSS とテーマ変数は <style> / style 属性でインライン出力される
  "style-src 'self' 'unsafe-inline'",
  `img-src 'self' data:${enableGa ? ` ${gaHosts.join(' ')}` : ''}`,
  `connect-src 'self'${enableGa ? ` ${gaHosts.join(' ')}` : ''}`,
  "font-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');

// アプリの配信ページ（トップ）にのみ SoftwareApplication の構造化データを付与する。
// 配信 URL が未設定＝未公開アプリなので、公開前のページには出さない。
const softwareAppJsonLd =
  isAppHome && app && app.appStoreUrl
    ? jsonForInlineScript({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: appName,
        operatingSystem: 'iOS',
        applicationCategory: schemaCategory ?? 'ProductivityApplication',
        url: canonical,
        ...(ogImageUrl ? { image: ogImageUrl } : {}),
        ...(app.version ? { softwareVersion: app.version } : {}),
        offers: {
          '@type': 'Offer',
          price: '0',
          // 本体は無料配布。表示通貨だけロケールに合わせる（課金は App Store 側の各ストアフロント価格）
          priceCurrency: locale === 'ja' ? 'JPY' : 'USD',
          url: app.appStoreUrl,
        },
      })
    : undefined;
---

<!doctype html>
<html lang={locale} data-app={app?.slug}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>

    <link rel="canonical" href={canonical} />
    {
      alternateUrls.map(({ locale: altLocale, href }) => (
        <link rel="alternate" hreflang={altLocale} href={href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternateUrls.find((a) => a.locale === defaultLocale)?.href ?? canonical} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}favicon.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={appName ?? site.operatorName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    {softwareAppJsonLd && <script type="application/ld+json" is:inline set:html={softwareAppJsonLd} />}

    {themeCss && <style is:inline set:html={themeCss} />}
    {enableGa && <GoogleAnalytics measurementId={gaId} analytics={pageAnalytics} />}
  </head>
  <body>
    <slot />
  </body>
</html>
