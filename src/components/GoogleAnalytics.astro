---
import { buildGaConfigScript, type PageAnalytics } from '@/lib/analytics';

interface Props {
  measurementId: string;
  analytics: PageAnalytics;
}

const { measurementId, analytics } = Astro.props;

// gtag config must be inline so first paint can send page_view with custom params.
// 同じ文字列のハッシュを BaseLayout の CSP（script-src）に入れているので、ここだけ変更しないこと。
const configScript = buildGaConfigScript(measurementId, analytics);
---

<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`}></script>
<script is:inline set:html={configScript} />
